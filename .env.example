# TrendPrompt Engine — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# OpenAI (used for prompt generation)
OPENAI_API_KEY=sk-[INSERT_HERE]

# Supabase (auth + database)
SUPABASE_URL=https://[INSERT_HERE].supabase.co
SUPABASE_ANON_KEY=[INSERT_HERE]
SUPABASE_SERVICE_KEY=[INSERT_HERE]
SUPABASE_JWT_SECRET=[INSERT_HERE]

# Scraping (future features)
ETSY_API_KEY=[INSERT_HERE]
TWITTER_BEARER_TOKEN=[INSERT_HERE]
AMAZON_ACCESS_KEY=[INSERT_HERE]
AMAZON_SECRET_KEY=[INSERT_HERE]
AMAZON_PARTNER_TAG=[INSERT_HERE]
